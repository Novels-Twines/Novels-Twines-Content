{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novels-Twines Episode Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "novelId",
    "title",
    "order",
    "status",
    "file"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "novelId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "published",
        "archived"
      ]
    },
    "file": {
      "type": "string",
      "pattern": "\\.md$"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
